# Copy to apps/web/.env.local and fill in. Never commit real values.

# Supabase (local values: run `pnpm db:start`, then `pnpm exec supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the client. Bypasses RLS.
SUPABASE_SECRET_KEY=
# Server-only. Direct Postgres URL; DB integration tests default to the local one.
SUPABASE_DB_URL=
# Base URL used in auth email links (defaults to http://localhost:3000 outside production;
# Vercel previews fall back to their branch URL).
SITE_URL=

# Public demo shop (optional; production only). See README "Demo shop".
DEMO_USER_ID=
DEMO_USER_EMAIL=
# Server-only. Restored on every demo sign-in; never shown to visitors.
DEMO_PASSWORD=
DEMO_SHOP_SLUG=

# Twilio SMS (docs/adr/0008-background-jobs-and-messaging.md)
# `log` (default) never contacts Twilio; set `twilio` only where real texts should go out.
MESSAGING_MODE=log
TWILIO_ACCOUNT_SID=
# Server-only. Also verifies webhook signatures, so set it wherever webhooks arrive.
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Public base URL Twilio calls back (defaults to SITE_URL); a tunnel URL when testing webhooks locally.
TWILIO_WEBHOOK_BASE_URL=

# Background jobs. Server-only, 32+ random characters; must match the `jobs_secret` Vault secret.
JOBS_SECRET=

# No-show scoring service (docs/adr/0010-risk-scoring.md). Both unset = no risk scoring at all.
# Server-only; the secret is 32+ random characters and must match the service's ML_SHARED_SECRET.
ML_SERVICE_URL=
ML_SHARED_SECRET=
