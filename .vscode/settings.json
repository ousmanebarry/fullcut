{
	"editor.formatOnSave": false,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit",
		"source.organizeImports": "never"
	},
	"files.insertFinalNewline": true,
	"files.trimTrailingWhitespace": true,
	"eslint.workingDirectories": [{ "directory": "apps/web", "changeProcessCWD": true }],
	"js/ts.tsdk.path": "apps/web/node_modules/typescript/lib",
	"js/ts.tsdk.promptToUseWorkspaceVersion": true,
	"actionButtons": {
		"defaultColor": "#ffffff",
		"loadNpmCommands": false,
		"reloadButton": null,
		"commands": [
			{ "name": "$(play) Dev", "color": "#4ade80", "singleInstance": true, "command": "pnpm dev" },
			{
				"name": "$(checklist) Lint",
				"color": "#facc15",
				"singleInstance": true,
				"command": "pnpm lint"
			},
			{
				"name": "$(symbol-class) Types",
				"color": "#60a5fa",
				"singleInstance": true,
				"command": "pnpm typecheck"
			},
			{
				"name": "$(beaker) Test",
				"color": "#c084fc",
				"singleInstance": true,
				"command": "pnpm test"
			},
			{
				"name": "$(browser) E2E",
				"color": "#fb923c",
				"singleInstance": true,
				"command": "pnpm test:e2e"
			},
			{
				"name": "$(database) DB Start",
				"color": "#2dd4bf",
				"singleInstance": true,
				"command": "pnpm db:start"
			},
			{
				"name": "$(refresh) DB Reset",
				"color": "#f472b6",
				"singleInstance": true,
				"command": "pnpm db:reset"
			},
			{
				"name": "$(beaker) DB Test",
				"color": "#a78bfa",
				"singleInstance": true,
				"command": "pnpm db:test"
			},
			{
				"name": "$(debug-stop) DB Stop",
				"color": "#f87171",
				"singleInstance": true,
				"command": "pnpm db:stop"
			}
		]
	}
}
