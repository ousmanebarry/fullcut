{
	"name": "fullcut",
	"private": true,
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter web dev",
		"jobs:dev": "pnpm --filter web jobs:dev",
		"lint": "pnpm --filter web lint",
		"typecheck": "pnpm --filter web typecheck",
		"test": "pnpm --filter web test",
		"test:watch": "pnpm --filter web test:watch",
		"test:e2e": "pnpm --filter web test:e2e",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:test": "supabase test db && pnpm --filter web test:db",
		"db:types": "supabase gen types typescript --local > apps/web/lib/database.types.ts && prettier --write apps/web/lib/database.types.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"audit": "pnpm audit --prod --audit-level moderate",
		"prepare": "husky"
	},
	"lint-staged": {
		"apps/web/**/*.{ts,tsx,js,mjs,mts}": [
			"pnpm --filter web exec eslint --fix --max-warnings=0 --no-warn-ignored",
			"prettier --write"
		],
		"*.{json,css,yml,yaml}": "prettier --write"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"supabase": "^2.121.0"
	}
}
